{
  "name": "@fleetrac/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:risk-detail": "node --experimental-strip-types --test lib/risk-detail-copy.test.ts lib/risk-triage.test.ts lib/action-verification-ux.test.ts lib/live-signal-display.test.ts lib/overview-summary.test.ts lib/resolve-next-step.test.ts lib/format.test.ts",
    "demo:reset": "curl -s -X POST http://127.0.0.1:8000/api/v1/simulator/reset-demo",
    "demo:stop": "curl -s -X POST http://127.0.0.1:8000/api/v1/simulator/stop",
    "demo:baseline": "curl -s -X POST http://127.0.0.1:8000/api/v1/simulator/start -H 'Content-Type: application/json' -d '{\"mode\":\"continuous\",\"rate_profile\":\"baseline\",\"profile\":\"demo\",\"seed\":42}'",
    "demo:treasury": "curl -s -X POST http://127.0.0.1:8000/api/v1/simulator/pitch/treasury_unsupported_claim",
    "demo:phishing": "curl -s -X POST http://127.0.0.1:8000/api/v1/simulator/pitch/security_tool_scope",
    "demo:platform": "curl -s -X POST http://127.0.0.1:8000/api/v1/simulator/pitch/cs_latency_regression",
    "demo:health": "python3 ../../scripts/demo_health_check.py"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
